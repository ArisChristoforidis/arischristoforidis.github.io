---
layout: "base.njk"
---

<article class="article">
  <header class="article-header">
    <p class="eyebrow">note</p>
    <h1>{{ title }}</h1>
    {% if date %}<time class="post-meta" datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% endif %}
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>
