<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'The personal website of Aris Christoforidis.' }}">
  <meta name="theme-color" content="#f3f0e9">
  <title>{% if title %}{{ title }} · {% endif %}christoforidis.dev</title>

  <script>
    (() => {
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (_) {
        // Use the system preference when storage is unavailable.
      }
    })();
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <script defer src="/js/theme.js"></script>
  <script defer src="/js/image-viewer.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="site-nav">
      <a class="site-name" href="/" aria-label="christoforidis.dev home">christoforidis.dev</a>

      <nav aria-label="Primary navigation">
        <ul class="nav-links">
          <li><a href="/programming/"{% if page.url == '/programming/' %} aria-current="page"{% endif %}>projects</a></li>
          {% if collections.posts | length %}<li><a href="/posts/"{% if page.url == '/posts/' %} aria-current="page"{% endif %}>notes</a></li>{% endif %}
          <li><a href="/explore/"{% if page.url == '/explore/' %} aria-current="page"{% endif %}>explore</a></li>
        </ul>
      </nav>

    </div>
  </header>

  <main id="main-content"{% if pageClass %} class="{{ pageClass }}"{% endif %}>
    {{ content | safe }}
  </main>

  <dialog class="image-viewer" id="image-viewer" aria-label="Image viewer">
    <figure class="image-viewer-figure">
      <div class="image-viewer-frame">
        <img data-image-preview alt="">
      </div>
      <figcaption data-image-caption></figcaption>
    </figure>
  </dialog>

  <footer class="site-footer">
    <div class="site-footer-inner">
      <span>© {{ buildYear }} Aris Christoforidis</span>
      <span class="footer-links">
        <a href="mailto:contact.arisc@gmail.com">email</a>
        <a href="https://github.com/ArisChristoforidis">github</a>
      </span>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <span>theme</span>
      </button>
    </div>
  </footer>
</body>
</html>
