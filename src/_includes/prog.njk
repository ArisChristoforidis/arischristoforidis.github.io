---
layout: "base.njk"
---

<article class="article">
  <header class="article-header">
    <p class="eyebrow">project</p>
    <h1>{{ title }}</h1>
    {% if date %}<time class="post-meta" datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>{% endif %}

    {% if categories %}
    <div class="post-tags" aria-label="Categories">
      {% for category in categories %}
        <span class="post-tag">{{ category }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>
</article>
