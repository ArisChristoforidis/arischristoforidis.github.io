---
layout: "base.njk"
title: "Notes"
description: "Notes, experiments, and occasional writing by Aris Christoforidis."
permalink: "/posts/index.html"
---

<section class="item-list">
  <h1>{{ title }}</h1>
  {% if collections.posts | length %}
    <ul>
      {% for post in collections.posts | reverse %}
        <li>
          <a class="item-link" href="{{ post.url }}">
            <span class="item-title">{{ post.data.title }}</span>
            {% if post.data.summary %}<span class="item-summary">{{ post.data.summary }}</span>{% endif %}
            {% if post.data.date %}<time class="item-meta" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>{% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="item-empty">Notes are still forming.</p>
  {% endif %}
</section>
